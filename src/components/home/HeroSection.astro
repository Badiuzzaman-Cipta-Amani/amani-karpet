---
import { company } from "@/data/common.json";
import { whatsappUrl } from "@/utils/whatsapp";
import { Whatsapp } from "simple-icons-astro";
import { Truck, WashingMachine, Smile, Star } from "@lucide/astro";
import stats from "@/data/stats.json";

const rotatingWords = ["Masjid", "Hotel", "Rumah", "Kantor"];

/* The dashed ring is centred on the worker's head: centre (28%, 40%) of the
   photo width, radius 44%. Each card's centre sits on that circle (the card is
   pulled back by half its size with `translate`), at -135deg / -45deg / +45deg.
   Ring and cards only show from `lg` up; on phones the photo stands alone. */
const highlights = [
  { value: stats[0].value, label: "Karpet tercuci", Icon: WashingMachine, position: "left-[-3%] top-[9%]" },
  { value: stats[1].value, label: "Pelanggan senang", Icon: Smile, position: "left-[59%] top-[9%]" },
  { value: stats[3].value, label: "Rating pelanggan", Icon: Star, position: "left-[59%] top-[74%]" },
];
---

<section class="hero relative overflow-hidden text-white">
  <div class="hero-dots absolute inset-0" aria-hidden="true"></div>

  <div
    class="relative max-w-7xl mx-auto px-6 pt-32 pb-20 lg:pt-36 lg:pb-24 grid lg:grid-cols-[1fr_auto] gap-12 lg:gap-16 xl:gap-20 items-center lg:min-h-[46rem] xl:min-h-[50rem]"
  >
    <div class="max-w-xl">
      <p class="flex items-center gap-3 text-amani-yellow font-semibold mb-6">
        <span class="h-0.5 w-8 bg-amani-yellow rounded-full"></span>
        {company.tagline}
      </p>
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-extrabold uppercase leading-[1.05] tracking-tight mb-6"
      >
        Untuk semua kebutuhan cuci karpet{" "}
        <span class="motion-safe:sr-only">Anda</span>{" "}
        <span class="hero-rotator motion-reduce:hidden" aria-hidden="true">
          {
            rotatingWords.map((word, i) => (
              <span class="hero-rotator__word" style={`--i:${i}`}>
                {word}
              </span>
            ))
          }
        </span>
      </h1>
      <p class="text-lg text-white/80 leading-relaxed mb-9">
        Karpet rumah, kantor, hingga karpet masjid. Kami jemput, cuci dengan
        mesin khusus karpet, lalu antar kembali dalam kondisi bersih, wangi, dan
        kering sempurna.
      </p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4 sm:gap-5">
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-amani-yellow text-amani-blue-dark px-8 py-4 rounded-full font-bold text-base shadow-lg shadow-amani-yellow/25 hover:bg-amani-yellow-300 transition-colors"
        >
          <Whatsapp class="size-5" /> Pesan Sekarang
        </a>
        <span class="inline-flex items-center justify-center sm:justify-start gap-2 text-white/80 text-sm">
          <Truck class="size-5 text-amani-yellow" /> Gratis antar jemput area
          Sukabumi
        </span>
      </div>
    </div>

    <div
      class="hero-figure relative mx-auto w-full max-w-md sm:max-w-lg lg:mx-0 lg:w-[30rem] xl:w-[36rem] lg:max-w-none lg:justify-self-end self-end -mb-20 lg:-mb-24"
    >
      <div
        class="hero-ring hero-reveal hidden lg:block absolute left-[-16%] top-[-4%] w-[88%] aspect-square rounded-full border-2 border-dashed border-white/45"
        style="--d: 0.15s"
        aria-hidden="true"
      >
      </div>
      <img
        src="/images/hero.webp"
        alt="Petugas Amani Laundry Karpet memanggul gulungan karpet"
        width="3428"
        height="3300"
        class="hero-person hero-reveal relative block w-full h-auto"
        style="--d: 0s"
        fetchpriority="high"
        decoding="async"
      />
      {
        highlights.map(({ value, label, Icon, position }, i) => (
          <div
            class={`hero-card hero-reveal hidden lg:flex absolute ${position} -translate-x-1/2 -translate-y-1/2 items-center gap-2.5 sm:gap-3 bg-white text-amani-blue-dark rounded-2xl px-3.5 py-2.5 sm:px-4 sm:py-3 shadow-xl shadow-amani-blue-dark/25`}
            style={`--d: ${0.3 + i * 0.15}s; --float-d: ${i * 1.3}s`}
          >
            <span class="size-9 sm:size-10 shrink-0 rounded-xl bg-amani-yellow flex items-center justify-center">
              <Icon class="size-4.5 sm:size-5" />
            </span>
            <div>
              <p class="font-extrabold text-base sm:text-lg leading-none">{value}</p>
              <p class="text-[11px] sm:text-xs text-slate-600 mt-1">{label}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Same blend the old disc had, now as the whole backdrop. */
  .hero {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-amani-blue-light-400) 40%, var(--color-amani-blue)),
      color-mix(in srgb, var(--color-amani-blue-light-600) 40%, var(--color-amani-blue))
    );
  }
  .hero-dots {
    background-image: radial-gradient(
      rgba(255, 255, 255, 0.35) 1.5px,
      transparent 1.5px
    );
    background-size: 26px 26px;
    mask-image: linear-gradient(to bottom, black 25%, transparent 95%);
  }
  .hero-person {
    filter: drop-shadow(0 24px 32px rgba(6, 12, 31, 0.45));
  }
  /* On wide screens, push the whole figure into the page's outer margin so it
     sits further from the headline (never past the 1.5rem gutter). */
  @media (min-width: 80rem) {
    .hero-figure {
      margin-right: calc(-1 * min(8rem, max(0px, (100vw - 80rem) / 2)));
    }
  }

  /* Page-load reveal: person, then ring, then each card (--d staggers them).
     Cards keep drifting afterwards; the float starts once the reveal is done. */
  .hero-reveal {
    animation: hero-reveal 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d);
  }
  .hero-card {
    animation:
      hero-reveal 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both,
      hero-float 5s ease-in-out infinite;
    animation-delay: var(--d), calc(var(--d) + 0.7s + var(--float-d));
  }
  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-float {
    50% {
      transform: translateY(-9px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-card {
      animation: none;
    }
  }

  /* Each word slides in from above, holds, then drops out below.
     Four words share a 10s loop; --i staggers them by a quarter each. */
  .hero-rotator {
    display: inline-grid;
    clip-path: inset(0);
    /* Room for the underline inside the clip box, without changing line height. */
    padding-bottom: 0.2em;
    margin-bottom: -0.2em;
  }
  .hero-rotator__word {
    grid-area: 1 / 1;
    color: var(--color-amani-yellow);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.12em;
    animation: hero-word 10s cubic-bezier(0.7, 0, 0.3, 1) infinite both;
    animation-delay: calc(var(--i) * 2.5s - 0.6s);
  }
  @keyframes hero-word {
    0% {
      transform: translateY(-120%);
      opacity: 0;
    }
    6% {
      transform: translateY(0);
      opacity: 1;
    }
    25% {
      transform: translateY(0);
      opacity: 1;
    }
    31% {
      transform: translateY(120%);
      opacity: 0;
    }
    100% {
      transform: translateY(120%);
      opacity: 0;
    }
  }
</style>
