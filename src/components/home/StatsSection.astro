---
import stats from "@/data/stats.json";
import { Star } from "@lucide/astro";
---

<section class="stats relative overflow-hidden bg-amani-blue py-28 lg:py-36 px-6">
  <div
    class="absolute inset-0 bg-[url(/images/world-dots.svg)] bg-cover bg-center opacity-[0.14]"
    aria-hidden="true"
  >
  </div>
  <div class="relative max-w-7xl mx-auto">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <p class="text-sm font-semibold text-amani-yellow mb-4">Statistik</p>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-5"
      >
        Dipercaya ribuan pelanggan
      </h2>
      <p class="text-white/75 text-lg leading-relaxed">
        Dari rumah tangga sampai pengurus masjid di Sukabumi, mereka menyerahkan
        karpetnya kepada kami dan kembali lagi.
      </p>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {
        stats.map((s) => (
          <div
            class={`rounded-3xl p-6 sm:p-8 ${
              s.highlight ? "bg-amani-yellow" : "bg-white"
            } text-amani-blue-dark`}
          >
            <p class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-2 flex items-center gap-2">
              <span data-count={s.value}>{s.value}</span>
              {s.highlight && (
                <Star class="size-7 fill-amani-blue-dark text-amani-blue-dark" />
              )}
            </p>
            <p
              class={`text-sm sm:text-base font-medium ${
                s.highlight ? "text-amani-blue-dark/80" : "text-slate-600"
              }`}
            >
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Counts each stat up from 0 the first time the section scrolls into view.
  // Values keep their original formatting: "5.000+" (id-ID thousands), "4.9", "20+".
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const parse = (raw: string) => {
    const match = raw.match(/^([\d.,]+)(.*)$/);
    if (!match) return null;
    const [, num, suffix] = match;
    const thousands = /^\d{1,3}(\.\d{3})+$/.test(num);
    const decimals = thousands ? 0 : (num.split(".")[1]?.length ?? 0);
    const target = thousands ? Number(num.replace(/\./g, "")) : Number(num);
    const format = (n: number) =>
      (thousands ? Math.round(n).toLocaleString("id-ID") : n.toFixed(decimals)) + suffix;
    return { target, format };
  };

  const animate = (el: HTMLElement) => {
    const parsed = parse(el.dataset.count ?? "");
    if (!parsed || reduceMotion) return;
    const { target, format } = parsed;
    const duration = 1600;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = format(target * eased);
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const section = document.querySelector(".stats");
  if (section && counters.length) {
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        counters.forEach(animate);
        observer.disconnect();
      },
      { threshold: 0.3 },
    ).observe(section);
  }
</script>
