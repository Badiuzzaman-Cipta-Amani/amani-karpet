---
import { company } from "@/data/common.json";
import { Check } from "@lucide/astro";

const points = [
  "Mesin cuci khusus karpet",
  "Deterjen aman untuk anak & bayi",
  "Pengeringan sampai tuntas",
  "Gratis antar jemput Sukabumi",
];
---

<section id="tentang" class="bg-slate-50 py-20 lg:py-28 px-6">
  <div
    class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-14 lg:gap-20 items-center"
  >
    <div class="grid grid-cols-2 gap-4 max-w-lg mx-auto lg:mx-0 w-full">
      <div
        class="col-span-2 bg-amani-blue rounded-3xl p-8 sm:p-10 flex items-center justify-center min-h-56"
      >
        <div class="bg-white rounded-2xl px-6 py-4">
          <img
            src="/logo.png"
            alt={`Logo ${company.name}`}
            width="1200"
            height="823"
            class="h-28 w-auto"
          />
        </div>
      </div>
      <div class="aspect-square rounded-3xl overflow-hidden bg-slate-200">
        <img
          src="https://images.unsplash.com/photo-1711563880414-c3be6fdedc2d?w=600&q=80&auto=format&fit=crop"
          alt="Gulungan karpet yang sudah dicuci dan siap diantar"
          width="600"
          height="600"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="aspect-square rounded-3xl overflow-hidden bg-slate-200 -mt-8">
        <img
          src="https://images.unsplash.com/photo-1763479168456-779fb5cd361b?w=600&q=80&auto=format&fit=crop"
          alt="Kurir membawa gulungan karpet di pundaknya"
          width="600"
          height="600"
          loading="lazy"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <div>
      <p
        class="text-sm font-bold uppercase tracking-wide text-amani-blue-light mb-4"
      >
        Tentang Kami
      </p>
      <h2
        class="text-4xl sm:text-5xl font-extrabold uppercase leading-[1.05] tracking-tight mb-6"
      >
        <span class="text-amani-blue">Ribuan karpet</span><br />
        <span class="text-amani-blue-light">ditangani secara</span><br />
        <span class="text-amani-blue">profesional</span>
      </h2>
      <p class="text-slate-600 text-lg leading-relaxed mb-8">
        {company.name} melayani cuci karpet untuk rumah, kantor, kos, dan masjid
        di Sukabumi. Ribuan karpet dari berbagai bahan sudah melewati proses cuci
        kami: dari karpet tipis ruang tamu sampai karpet masjid puluhan meter,
        semuanya kembali bersih, wangi, dan kering sempurna.
      </p>
      <ul class="grid sm:grid-cols-2 gap-3">
        {
          points.map((p) => (
            <li class="flex items-center gap-3 text-amani-blue-dark font-medium">
              <span class="size-6 rounded-full bg-amani-yellow flex items-center justify-center shrink-0">
                <Check class="size-3.5" />
              </span>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
